; Uniforms
.fvec       projection[4]        ; #0 - 3
.fvec       textureScale         ; #4
.fvec       textureOffset        ; #5
                                 ; x = texture offset (0.0 or 1.0 for mode5/6 hi-res flipping)
.fvec       stereoIOD            ; #6 - (tier0 shift, tier1 shift, boundary 0/1)
.fvec       stereoDim            ; #7 - (dim0..dim3) editor spotlight alpha multipliers
                                 ;      (the tile TEV replaces RGB from TEXTURE0 but
                                 ;      modulates alpha with the vertex color, so the
                                 ;      spotlight hides the sibling priorities via the
                                 ;      alpha test instead of dimming their RGB)
.fvec       mode7Persp           ; #9 - Mode 7 plane, set only while it draws (all 0 otherwise):
                                 ;      x = ramp strength k (0..1), y = near-row gain (1..2),
                                 ;      z = -fog amount (rows fog by distance into color.b),
                                 ;      w = -ghost offset (blur grows with distance)
.fvec       ground               ; #10 - sprites follow the Mode 7 ground (issue #76), armed
                                 ;      only for the sprite layer's draw: x = near shift,
                                 ;      y = far - near, z = 256 when armed / -1 disarmed
                                 ;      (the branch test), w = 1 armed / 0 (spotlight gate)
.fvec       groundTab[32]        ; #11-42 - per signature slot: x = 1 on the ground / 0 keeps
                                 ;      the sprite gauges, y = editor spotlight alpha
.fvec       stereoIOD2           ; #8 - (tier2 shift, tier3 shift, boundary 1/2,
                                 ;      boundary 2/3). BG layers park both boundaries
                                 ;      far above any plane so only tiers 0/1 exist;
                                 ;      the OBJ layer uses all four (issue #60: sprite
                                 ;      planes are (priority+1)*3 = 3/6/9/12)

; Constants
.constf c_base          (0, 1, 2, 8)    ; (x, y, z, w)
.constf c_tex           (32768, 16384, 0.0078125, 128)
.constf c_alpha         (24576, 8192, 255, 0)
.constf c_depth         (0.03125, -256, 0.00390625, 0)
.constf c_m7            (-1, 0.00390625, 1, 0)   ; Mode 7 perspective helpers: -1, 1/256, 1
.constf c_ground        (256, 0.00390625, -0.003921569, 1)   ; slot unit, 1/256, -1/255, 1

; Outputs
.out        outpos      position
.out        outtex      texcoord0
.out        outcol      color

; Inputs (defined as aliases for convenience)
.alias      inpos       v0      ; x = x (xxxxxxxx xxxxxxxx) 
                                ; x: x (-256 to 511)

                                ; y = y (0aa0dddd yyyyyyyy)
                                ; a: alpha (0 = 0.0, 1 = 0.5, 2 = 1.0, 3 = undefined)
                                ; d: depth (0 - 16)
                                ; y: y (0 - 255)
                                 
                                ; z = (vhtttttt tttttttt) or 0
                                ; v: Flip vertical
                                ; h: Flip horizontal
                                ; t: tex base
                                ; w = 1
.alias      intex       v1      ; (u, v) or (r, g, b, a)

.entry vmain
.proc vmain
    mov     r0, inpos
    mov     r10, intex

    mov     r1, c_base
    mov     r2, c_tex
    
    add     r10.x, textureOffset.x, r10.x

    cmp     r0.z, eq, eq, r1.x
    jmpc    cmp.x, alpha_computation

computing_vflip:
    cmp     r0.z, ge, ge, r1.x          ; is r0.z > 0? (or 0x8000 is not set)
    jmpc    cmp.x, computing_hflip      ; if no vflip go to computing_hflip, else:
    mad     r10.y, r10.y, -r1.y, r1.w   ; r10.y = (r10.y * -1) + 8
    add     r0.z, r0.z, r2.x            ; r0.z = r0.z + 32768 (removes the 0x8000 bit)

computing_hflip:
    cmp     r0.z, lt, lt, r2.y          ; is r0.z < 16384? (or 0x4000 is not set)
    jmpc    cmp.x, computing_tex_pos    ; if no hflip go to no_hflip, else:
    mad     r10.x, r10.x, -r1.y, r1.w   ; r10.x = (r10.x * -1) + 8
    add     r0.z, r0.z, -r2.y           ; r0.z = r0.z - 16384 (removes the 0x4000 bit)

computing_tex_pos:
    mul     r9.y, r0.z, r2.z            ; r9.y = r0.z * (1/128)
    flr     r9.y, r9.y                  ; r9.y = floor(r9.y)
    mad     r9.x, r9.y, -r2.w, r0.z     ; r9.x = r0.z - r9.y * 128
    mad     r10.xy, r9.xy, r1.w, r10.xy ; r10.xy = r10.xy + r9.xy * 8
    
alpha_computation:
    mov     r11, intex
    mov     r1, c_alpha

    cmp     r0.y, lt, lt, r1.x          ; is r0.y < 24576?
    jmpc    cmp.x, alpha_lt_0_0         ; if yes then do nothing, else:
    add     r0.y, r0.y, -r1.x           ; r0.y = r0.y - 24576
    mov     r11.w, c_base.y             ; alpha = 1 (slightly more alpha leak, but not visible...)
alpha_lt_0_0:
    cmp     r0.y, lt, lt, r2.y          ; is r0.y < 16384?
    jmpc    cmp.x, alpha_lt_1_0         ; if yes then do nothing, else:
    add     r0.y, r0.y, -r2.y           ; r0.y = r0.y - 16384
    mov     r11.w, r1.z                 ; alpha = 255
alpha_lt_1_0:
    cmp     r0.y, lt, lt, r1.y          ; is r0.y < 8192?
    jmpc    cmp.x, depth_computation    ; if yes then do nothing, else:
    add     r0.y, r0.y, -r1.y           ; r0.y = r0.y - 8192
    mov     r11.w, r2.w                 ; alpha = 128

depth_computation:
    cmp     r0.y, lt, lt, r1.w          ; if r0.y < 0, 
    jmpc    cmp.x, draw                 ; then do nothing, else:

    mov     r1, c_depth
    mul     r0.z, r0.y, r1.z            ; r0.z = r0.y / 256
    flr     r0.z, r0.z                  ; r0.z = floor(r0.y / 256)
    mad     r0.y, r0.z, r1.y, r0.y      ; r0.y = r0.y + r0.z * (-256) = r0.y - floor(r0.y / 256) * 256
    mul     r0.z, r0.z, r1.x            ; r0.z = r0.z / 16

draw:
    ; pass through, set final values for projection, textureScale and color in geo shader
    ; Stereo parallax per priority (issue #60): four depth tiers, picked
    ; by comparing this tile's decoded depth plane (r0.z = d/32) against
    ; the three ascending boundaries. Each passed boundary promotes the
    ; selection one tier (overwrite cascade - picasso has no unconditional
    ; jmp). With all shifts equal and boundaries 0/parked this collapses
    ; to the flat behaviour, an exact no-op in 2D.
    mov     r1.xyz, stereoIOD.xyz       ; s0, s1, b01
    mov     r3, stereoIOD2              ; s2, s3, b12, b23
    mov     r2, stereoDim               ; d0, d1, d2, d3
    mov     r4.x, r1.x                  ; tier 0 shift
    mov     r4.y, r2.x                  ; ...and its spotlight alpha
    cmp     r0.z, ge, ge, r1.z          ; plane >= b01 -> tier 1
    ifc     cmp.x
        mov     r4.x, r1.y
        mov     r4.y, r2.y
    .end
    cmp     r0.z, ge, ge, r3.z          ; plane >= b12 -> tier 2
    ifc     cmp.x
        mov     r4.x, r3.x
        mov     r4.y, r2.z
    .end
    cmp     r0.z, ge, ge, r3.w          ; plane >= b23 -> tier 3
    ifc     cmp.x
        mov     r4.x, r3.y
        mov     r4.y, r2.w
    .end
    ; Mode 7 perspective (issue #62): a scanline vertex carries
    ; w = 256 * (nearest span / its span); tiles carry the loader's w.
    ; With mode7Persp.x = 0 outside Mode 7 draws this is 1 + 0 = exact no-op.
    mov     r5, c_m7                            ; (-1, 1/256, 1, 0): mad's src3 must be a temp
    mad     r6.x, r0.w, r5.y, r5.x              ; d = w/256 - 1  (0 at the nearest row, -1 at the horizon)
    mad     r5.x, r6.x, mode7Persp.x, r5.z      ; 1 + k * d
    mul     r5.x, mode7Persp.y, r5.x            ; * near-row gain (a uniform must be src1 in mul)
    mul     r4.x, r4.x, r5.x
    mad     r4.x, r6.x, mode7Persp.w, r4.x      ; + d * (-ghost) = ghost * (1 - w/256): blur by distance
    mad     r11.z, r6.x, mode7Persp.z, r11.z    ; color.b += d * (-fog) = fog * (1 - w/256): fog by
                                                ; distance (a line's b is 0; every other draw has z = 0)
    ; Sprites follow the Mode 7 ground (issue #76): a sprite vertex carries
    ; w = rowW + 256 * slot (3dsgroundsprites.h). slot -> groundTab[slot]
    ; (ground flag, spotlight); rowW 1..255 = its bottom row's distance,
    ; 0 = not on the plane. Armed (ground.z = 256) only for the sprite draw:
    ; every other draw has ground.z = -1, so the branch never takes and the
    ; spotlight gate (ground.w = 0) leaves alpha untouched - exact no-op.
    mov     r5, c_ground
    mov     r7, ground
    mul     r6.y, r0.w, r5.y                    ; w / 256
    flr     r6.y, r6.y                          ; slot
    mad     r6.z, r6.y, -r5.x, r0.w             ; rowW = w - slot * 256
    mova    a0.x, r6.y
    mov     r8, groundTab[a0.x]                 ; x = on ground, y = spotlight alpha
    ; spotlight: alpha *= 1 + armed * (tab.y - 1)  (1 when disarmed)
    add     r8.y, r8.y, -r5.w
    mad     r8.y, r8.y, r7.w, r5.w
    mul     r4.y, r4.y, r8.y
    ; branch: 0 < rowW < ground.z
    mov     r9.x, r5.x                          ; scratch: (0, ground.z) vs (rowW, rowW)
    mov     r9.x, c_base.x
    mov     r9.y, r7.z
    cmp     r9.xy, lt, gt, r6.zz
    ifc     cmp.x && cmp.y
        ; t = 1 - rowW/255 ; shiftG = near + (far - near) * t
        mad     r6.w, r6.z, r5.z, r5.w
        mad     r9.z, r6.w, r7.y, r7.x
        ; blend by the slot's ground flag: r4.x += flag * (shiftG - r4.x)
        add     r9.z, r9.z, -r4.x
        mad     r4.x, r8.x, r9.z, r4.x
    .end
    add     r0.x, r4.x, r0.x
    mul     r11.w, r4.y, r11.w          ; editor spotlight: other priorities'
                                        ; alpha goes to 0 (alpha test discards
                                        ; them); 1.0 in gameplay = exact no-op
    mov     outpos, r0
    mov     outtex, r10
    mov     outcol, r11

    end
.end